# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# You can find these in your Firebase Console under Project Settings > General

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Maps (for vendor location on profile page)
# Enable Maps JavaScript API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Note: OpenAI API key is now handled securely on the backend only
# Do NOT add VITE_OPENAI_API_KEY to frontend environment variables
